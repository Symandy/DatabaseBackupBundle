{
    "name": "symandy/database-backup-bundle",
    "description": "A Symfony Bundle to handle databases backup",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Symandy\\DatabaseBackupBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symandy\\Tests\\DatabaseBackupBundle\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Samaël Villette",
            "email": "villette.samael@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/http-kernel": "^6.4 || ^7.1",
        "symfony/dependency-injection": "^6.4 || ^7.1",
        "symfony/config": "^6.4 || ^7.1",
        "symfony/process": "^6.4 || ^7.1",
        "symfony/serializer": "^6.4 || ^7.1",
        "symfony/property-access": "^6.4 || ^7.1",
        "nyholm/dsn": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.5",
        "phpunit/phpunit": "^9.5",
        "symfony/phpunit-bridge": "^6.4 || ^7.1",
        "symfony/framework-bundle": "^6.4 || ^7.1",
        "symfony/yaml": "^6.4 || ^7.1",
        "symfony/console": "^6.4 || ^7.1",
        "doctrine/orm": "^2.11",
        "symfony/dotenv": "^6.4 || ^7.1",
        "webmozart/assert": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.16"
    },
    "scripts": {
        "cs-fixer": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    }
}
